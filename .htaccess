# YanaYacu Clean — .htaccess

Options -Indexes

RewriteEngine On

# Force HTTPS + www in a single hop (avoids redirect chains).
# X-Forwarded-Proto check prevents loops behind proxies (e.g. Cloudflare Flexible SSL).
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^(.*)$ https://www.%1%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTPS} on [OR]
RewriteCond %{HTTP:X-Forwarded-Proto} https [NC]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteCond %{HTTP_HOST} ^(.+)$ [NC]
RewriteRule ^(.*)$ https://www.%1%{REQUEST_URI} [L,R=301]

# ---------------------------------------------------------------
# Sensitive paths: never served over HTTP (404)
# ---------------------------------------------------------------
# Directories (git, agent files, build sources, claim records, PHP libs)
RewriteRule ^(\.git|\.atl|node_modules|src|scripts|reclamaciones|reclamaciones-data|lib)(/|$) - [R=404,L,NC]
# Any dotfile or dot-directory except .well-known
RewriteRule (^|/)\.(?!well-known(/|$)) - [R=404,L]

# Sensitive files
<FilesMatch "(^config\.smtp.*\.php$|^package(-lock)?\.json$|^tailwind\.config\.js$|\.(md|log|lock|bak|sql|sh|zip)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS text/javascript application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS application/xml image/svg+xml
</IfModule>

# Browser caching (css/js are versioned with ?v= by the build)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg         "access plus 1 month"
  ExpiresByType image/jpeg        "access plus 1 month"
  ExpiresByType image/png         "access plus 1 month"
  ExpiresByType image/webp        "access plus 1 month"
  ExpiresByType image/svg+xml     "access plus 1 month"
  ExpiresByType application/pdf   "access plus 1 year"
  ExpiresByType font/woff2        "access plus 1 year"
  ExpiresByType image/x-icon      "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
  ExpiresByType text/css          "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript   "access plus 1 month"
  ExpiresByType application/xml   "access plus 1 day"
  ExpiresByType text/xml          "access plus 1 day"
  ExpiresByType text/html         "access plus 1 day"
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Content-Security-Policy (enforcing). Verified with headless Chrome: zero violations on the
  # home, the three landing pages, 404, privacy, terms and the claims form (see README).
  # - No 'unsafe-eval': Alpine runs as the CSP build (@alpinejs/csp), components in assets/js/alpine-components.js.
  # - No inline <script>: all scripts are files under assets/. JSON-LD (type application/ld+json) is data, not executed.
  # - style-src keeps 'unsafe-inline' on purpose: style="" attributes are used across the pages and by Swiper/GSAP/Motion at runtime.
  # - hCaptcha (claims form and distributor form) needs its script, frame and connect origins.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://js.hcaptcha.com https://*.hcaptcha.com; style-src 'self' 'unsafe-inline' https://*.hcaptcha.com; font-src 'self'; img-src 'self' data:; frame-src 'self' https://*.hcaptcha.com; connect-src 'self' https://*.hcaptcha.com; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'"
</IfModule>

# Error page
ErrorDocument 404 /404.html

# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php82" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
